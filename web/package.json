{
  "name": "hamix-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check:standards": "go run ../cmd/checkstandards",
    "mock:graph:generate": "node ./scripts/generate-graph-mock.mjs",
    "mock:graph:100k": "node ./scripts/generate-graph-mock.mjs --node-count=100000 --output=public/mock-data/graphs/task-graph-100k.json",
    "mock:graph:200k": "node ./scripts/generate-graph-mock.mjs --node-count=200000 --output=public/mock-data/graphs/task-graph-200k.json",
    "mock:graph:use": "node ./scripts/use-graph-mock.mjs",
    "mock:graph:use:100k": "node ./scripts/use-graph-mock.mjs --size=100k",
    "mock:graph:use:200k": "node ./scripts/use-graph-mock.mjs --size=200k",
    "mock:graph:use:500k": "node ./scripts/use-graph-mock.mjs --size=500k"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.37",
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@floating-ui/react": "^0.27.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@tanstack/query-sync-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.100.5",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "@tiptap/core": "^3.30.1",
    "@tiptap/extension-bubble-menu": "3.30.1",
