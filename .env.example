# Copy to `.env` in the repo root.
#
# Required — Postgres connection for taskapi.
DATABASE_URL=postgres://user:pass@localhost:5432/hamix?sslmode=disable

# Required — Cursor SDK key for compose-page draft assist.
# taskapi and hamix-desktop refuse to listen without this (no fake runner).
# Canonical name only: CURSOR_API_KEY (not CURSOR_KEY).
CURSOR_API_KEY=

# Optional — absolute path to the hamix-draft-agent launcher. scripts/dev.*
# and scripts/dev-desktop.* set HAMIX_DRAFT_AGENT_BIN after building the sidecar.
# HAMIX_DRAFT_AGENT_BIN=

#
# Optional — after git pull that changes schema (see CONTRIBUTING.md)
# .\scripts\migrate.ps1   # Windows
# ./scripts/migrate.sh     # Unix
#
# taskapi writes to ./logs under the repo.
# HAMIX_LOG_LEVEL=debug   # debug | info | warn | error (default: info; case-insensitive; warn accepts "warning")
# HAMIX_DISABLE_LOGGING=1 # no JSON file; errors only on stderr
